query KadssPaymentSummary($confirmationTokenID: String!, $subscriptionID: String!) {
  kadssPaymentSummary(
    confirmationTokenID: $confirmationTokenID
    subscriptionID: $subscriptionID
  ) {
    districtID
    nickname
    email
    orgType
    orgName
    billingAddress {
      line1
      line2
      city
      state
      postalCode
      country
      __typename
    }
    cardDisplayBrand
    cardLast4
    productName
    quantity
    subtotalCents
    taxCents
    totalCents
    discountCents
    promoCode
    couponName
    __typename
  }
}