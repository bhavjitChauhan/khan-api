query loggedInUserQuery {
  user {
    id
    kaid
    canAccessDistrictsHomepage
    isTeacher
    hasUnresolvedInvitations
    isInKhanClassroomDistrict
    preferredKaLocale {
      id
      kaLocale
      status
      __typename
    }
    userDistrictInfos {
      id
      district {
        id
        kaLocale
        __typename
      }
      __typename
    }
    homepageUrl
    __typename
  }
}