query getAssessmentItemByProblemNumber($exerciseId: ID!, $problemNumber: Int!, $hideVisual: Boolean!) {
  assessmentItemByProblemNumber(
    exerciseId: $exerciseId
    problemNumber: $problemNumber
    hideVisual: $hideVisual
  ) {
    item {
      ...KA_assessmentItemFields
      __typename
    }
    error {
      code
      debugMessage
      __typename
    }
    __typename
  }
}

fragment KA_assessmentItemFields on AssessmentItem {
  __typename
  id
  sha
  problemType
  itemDataAnswerless
  isContextInaccessible
  requiresScreenOrMouse
}