query KAClassroom_ClassroomInfoByDescriptor($classDescriptor: String!) {
  classroom: classroomByDescriptor(descriptor: $classDescriptor) {
    id
    cacheId
    founder: coach {
      id
      kaid
      nickname
      __typename
    }
    descriptor
    name
    signupCode
    allTeachers {
      id
      kaid
      nickname
      __typename
    }
    __typename
  }
}