query KAClassroom_GetActionableInsights($classroomDescriptor: String) {
  actionableInsights(queryBy: {classroomDescriptor: $classroomDescriptor}) {
    id
    type
    callsToAction {
      type
      __typename
    }
    classroom {
      id
      cacheId
      name
      descriptor
      signupCode
      __typename
    }
    referencedContent {
      id
      title
      __typename
    }
    referencedUsers {
      id
      kaid
      username
      nickname
      __typename
    }
    referencedThreads {
      id
      flagged
      lastUpdatedAt
      __typename
    }
    referencedAssignments {
      id
      dueDate
      __typename
    }
    __typename
  }
}