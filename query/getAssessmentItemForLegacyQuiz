query getAssessmentItemForLegacyQuiz($exerciseId: ID!, $quizProblemNumber: Int!) {
  assessmentItemForLegacyQuiz(
    exerciseId: $exerciseId
    quizProblemNumber: $quizProblemNumber
  ) {
    item {
      ...KA_assessmentItemFields
      __typename
    }
    error {
      code
      debugMessage
      __typename
    }
    __typename
  }
}

fragment KA_assessmentItemFields on AssessmentItem {
  __typename
  id
  sha
  problemType
  itemDataAnswerless
  isContextInaccessible
}