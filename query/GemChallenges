query GemChallenges($userKaid: String!, $classroomDescriptors: [String!]) {
  user(kaid: $userKaid) {
    id
    classrooms {
      id
      cacheId
      descriptor
      name
      __typename
    }
    gemChallenges(classroomDescriptors: $classroomDescriptors) {
      classroomDescriptor
      targetGems
      currentClassGems
      userGemsContributed
      deadline
      reward
      __typename
    }
    __typename
  }
}