query schoolPickerAdminPackageFetchVersions($countryCode: String!, $after: String, $pageSize: Int) {
  eduOrgDatasetLiveVersionForCountry(countryCode: $countryCode) {
    id
    __typename
  }
  eduOrgDatasetVersionsForCountry(
    countryCode: $countryCode
    after: $after
    pageSize: $pageSize
  ) {
    versions {
      id
      creator {
        id
        nickname
        __typename
      }
      importStartedAt
      importCompletedAt
      publishedAt
      __typename
    }
    pageInfo {
      nextCursor
      __typename
    }
    __typename
  }
}