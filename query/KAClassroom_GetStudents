query KAClassroom_GetStudents($classDescriptor: String!) {
  classroomByDescriptorV2(descriptor: $classDescriptor) {
    id
    cacheId
    descriptor
    students {
      id
      coachNickname
      email
      userDistrictInfos {
        id
        isActivated
        __typename
      }
      __typename
    }
    __typename
  }
}