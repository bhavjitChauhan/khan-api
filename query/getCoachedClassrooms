query getCoachedClassrooms {
  user {
    id
    coachedClassrooms(shouldOmitCACs: true) {
      id
      cacheId
      name
      descriptor
      students: studentKaidsAndNicknames {
        id
        nickname: coachNickname
        __typename
      }
      countStudents
      __typename
    }
    __typename
  }
}