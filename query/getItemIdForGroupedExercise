query getItemIdForGroupedExercise($exerciseId: String!) {
  assessmentItemsForGroupedItemTask(
    exerciseId: $exerciseId
    nextProblemNumber: 1
    numItems: 1
    alreadyCompletedItemIds: []
  ) {
    value {
      id
      __typename
    }
    error {
      code
      debugMessage
      __typename
    }
    __typename
  }
}