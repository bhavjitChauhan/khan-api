query KAClassroom_GetQuizTaskAttemptSummary($taskId: String!, $unitId: String!) {
  user {
    id
    exerciseData {
      quizAttempt(taskId: $taskId, topicId: $unitId) {
        taskKey: id
        numAttempted
        numCorrect
        skillLevelChanges {
          ...skillLevelChangeFields
          __typename
        }
        __typename
      }
      __typename
    }
    __typename
  }
}

fragment skillLevelChangeFields on SkillLevelChange {
  id
  skillId
  after
  __typename
}