query productByName($name: String!) {
  productByName(name: $name) {
    id
    name
    isActive
    description
    extProductID
    validationBillingCountries
    prices {
      currency
      extProductID
      id
      recurringInterval
      recurringIntervalCount
      type
      unitAmount
      __typename
    }
    __typename
  }
}