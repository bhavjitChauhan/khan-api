query StudentListsQuery {
  coach: user {
    id
    studentLists: coachedClassrooms {
      id
      cacheId
      descriptor
      name
      signupCode
      topics {
        id
        slug
        translatedStandaloneTitle
        __typename
      }
      isK4dClassroom
      isChildAssignmentsClassroom
      __typename
    }
    __typename
  }
}