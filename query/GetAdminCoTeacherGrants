query GetAdminCoTeacherGrants($districtID: String!) {
  user {
    id
    userDistrictInfos(districtID: $districtID) {
      id
      adminCoTeacherGrants {
        expiresAt
        classroomDistrictInfo {
          id
          keyNameID
          name
          classroom {
            id
            cacheId
            signupCode
            __typename
          }
          teacherUserDistrictInfo {
            id
            displayName
            __typename
          }
          school {
            id
            name
            __typename
          }
          district {
            id
            name
            isKhanClassroomDistrict
            __typename
          }
          __typename
        }
        __typename
      }
      __typename
    }
    __typename
  }
}