query getIndexedContentSearchResults($query: String!, $allowedTopicAncestors: [String], $contentKinds: [String], $pageNum: Int, $numResults: Int) {
  searchPage(
    query: $query
    allowedTopicAncestors: $allowedTopicAncestors
    contentKinds: $contentKinds
    pageNum: $pageNum
    numResults: $numResults
  ) {
    metadata {
      currentPage
      numPages
      resultCount
      __typename
    }
    pageInfo {
      nextCursor
      __typename
    }
    results {
      contentId
      kind
      curationNode {
        id
        contentKind
        slug
        iconPath
        translatedTitle
        translatedDescription
        relativeUrl
        topicPaths {
          path {
            id
            kind
            slug
            content {
              ... on Topic {
                id
                curriculumKey
                iconPath
                translatedTitle
                __typename
              }
              __typename
            }
            __typename
          }
          __typename
        }
        __typename
      }
      learnableContent {
        id
        contentKind
        slug
        translatedTitle
        translatedDescription
        defaultUrlPath
        topicPaths {
          path {
            id
            kind
            slug
            content {
              ... on Topic {
                id
                curriculumKey
                iconPath
                translatedTitle
                __typename
              }
              __typename
            }
            __typename
          }
          __typename
        }
        __typename
      }
      __typename
    }
    __typename
  }
}