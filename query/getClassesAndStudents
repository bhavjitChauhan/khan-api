query getClassesAndStudents {
  coach: user {
    id
    studentLists: coachedClassrooms {
      id
      descriptor
      cacheId
      name
      signupCode
      studentKaidsAndNicknames {
        id
        kaid
        coachNickname
        __typename
      }
      topics {
        id
        __typename
      }
      isK4dClassroom
      isChildAssignmentsClassroom
      __typename
    }
    __typename
  }
}