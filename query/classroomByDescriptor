query classroomByDescriptor($descriptor: String!) {
  classroomByDescriptorV2(descriptor: $descriptor) {
    id
    cacheId
    topics {
      id
      key
      translatedTitle
      domainSlug
      sourceKaLocale
      parent {
        id
        translatedTitle
        __typename
      }
      __typename
    }
    students {
      id
      kaid
      coachNickname
      __typename
    }
    isK4dClassroom
    isKmapClassroom
    classroomDistrictInfo {
      id
      district {
        id
        goal {
          courseMasteryTargets {
            course {
              id
              translatedTitle
              sourceKaLocale
              __typename
            }
            gradeLevels
            __typename
          }
          __typename
        }
        __typename
      }
      __typename
    }
    __typename
  }
}