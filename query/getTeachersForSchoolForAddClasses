query getTeachersForSchoolForAddClasses($schoolID: String!) {
  getTeachersForSchool(schoolID: $schoolID) {
    id
    keyNameID
    kaid
    displayName
    fullName
    coachedClassroomDistrictInfos {
      id
      name
      keyNameID
      classroom {
        id
        cacheId
        signupCode
        __typename
      }
      __typename
    }
    __typename
  }
}