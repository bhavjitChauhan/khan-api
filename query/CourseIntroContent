query CourseIntroContent($descriptor: String!, $parentCourseId: String!) {
  learnableContentByDescriptors(contentDescriptors: [$descriptor]) {
    id
    urlWithinClosestAncestor(ancestorIds: [$parentCourseId])
    contentKind
    ... on Video {
      duration
      thumbnailUrl
      __typename
    }
    __typename
  }
}