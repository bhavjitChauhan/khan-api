mutation UpdateIncompleteSubscription($quantity: Int!, $subscriptionID: ID!, $confirmationToken: String, $promoCode: String) {
  updateKadssIncompleteSubscription(
    quantity: $quantity
    subscriptionID: $subscriptionID
    confirmationToken: $confirmationToken
    promoCode: $promoCode
  ) {
    clientSecret
    subscriptionID
    error {
      code
      debugMessage
      __typename
    }
    __typename
  }
}