mutation EditSchoolNameForDistrict($districtID: ID!, $schoolID: ID!, $schoolName: String!) {
  editSchoolNameForDistrict(
    districtID: $districtID
    schoolID: $schoolID
    schoolName: $schoolName
  ) {
    school {
      id
      name
      __typename
    }
    error {
      code
      __typename
    }
    __typename
  }
}