mutation signupDistrictsWithPasswordMutation($email: String!, $password: String!, $firstname: String!, $lastname: String!, $role: UserRole, $birthdate: Date) {
  signupDistrictsWithPassword(
    email: $email
    password: $password
    firstname: $firstname
    lastname: $lastname
    role: $role
    birthdate: $birthdate
  ) {
    user {
      id
      kaid
      __typename
    }
    error {
      code
      __typename
    }
    __typename
  }
}