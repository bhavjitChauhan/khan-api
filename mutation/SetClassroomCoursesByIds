mutation SetClassroomCoursesByIds($classDescriptor: String!, $localizedCourses: [LocalizedCourseInput!]!) {
  setClassroomCoursesByIds(
    classroomDescriptor: $classDescriptor
    localizedCourses: $localizedCourses
  ) {
    classroom {
      id
      cacheId
      topics {
        id
        masteryEnabled
        __typename
      }
      __typename
    }
    error {
      code
      __typename
    }
    __typename
  }
}