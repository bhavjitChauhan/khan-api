mutation SetClassroomCoursesByIds($classDescriptor: String!, $courseIds: [String!]!) {
  setClassroomCoursesByIds(
    classroomDescriptor: $classDescriptor
    courseIds: $courseIds
  ) {
    classroom {
      id
      cacheId
      topics {
        id
        masteryEnabled
        __typename
      }
      __typename
    }
    error {
      code
      __typename
    }
    __typename
  }
}