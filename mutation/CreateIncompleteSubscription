mutation CreateIncompleteSubscription($stripePriceID: ID!, $quantity: Int!, $confirmationToken: String, $promoCode: String) {
  createKadssIncompleteSubscription(
    stripePriceID: $stripePriceID
    quantity: $quantity
    confirmationToken: $confirmationToken
    promoCode: $promoCode
  ) {
    customerID
    clientSecret
    subscriptionID
    error {
      code
      debugMessage
      __typename
    }
    __typename
  }
}