mutation DistrictsPackage_BillingAccess_UpdateOrgPurchaseAdmins($orgID: ID!, $partnershipID: ID, $kaids: [String!]!) {
  updateOrgPurchaseAdmins(
    orgID: $orgID
    partnershipID: $partnershipID
    kaids: $kaids
  ) {
    error {
      code
      debugMessage
      __typename
    }
    __typename
  }
}