mutation createGrammarChallengeAttemptMutation($input: CreateLanglitChallengeAttemptInput!) {
  createLanglitChallengeAttempt(input: $input) {
    attempt {
      id
      userKAID
      langlitChallengeId
      performance
      assignmentId
      createdAt
      __typename
    }
    error {
      code
      __typename
    }
    __typename
  }
}