mutation addStudentsToClassrooms($kaids: [ID!]!, $classroomDescriptors: [String!]!) {
  addStudentsToClassrooms(
    kaids: $kaids
    classroomDescriptors: $classroomDescriptors
  ) {
    coach {
      id
      kaid
      __typename
    }
    error {
      code
      __typename
    }
    __typename
  }
}