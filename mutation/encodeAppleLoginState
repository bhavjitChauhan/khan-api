mutation encodeAppleLoginState($action: Action!, $continueUrl: String!, $role: UserRole, $signupCodes: [String], $verifyRedirectHost: String) {
  encodeAppleLoginState(
    action: $action
    continueUrl: $continueUrl
    role: $role
    signupCodes: $signupCodes
    verifyRedirectHost: $verifyRedirectHost
  ) {
    redirectUri
    state
    __typename
  }
}