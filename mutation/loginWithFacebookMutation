mutation loginWithFacebookMutation($token: String!, $role: UserRole, $inviteId: String, $flowType: OAuthFlowType) {
  loginWithFacebook(
    token: $token
    role: $role
    inviteId: $inviteId
    flowType: $flowType
  ) {
    user {
      id
      kaid
      __typename
    }
    isFirstLogin
    error {
      code
      __typename
    }
    __typename
  }
}