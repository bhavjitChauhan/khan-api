mutation loginWithAppleAuthCodeAndState($authCode: String!, $state: String!, $userData: AppleUserData, $role: UserRole, $flowType: OAuthFlowType) {
  loginWithAppleAuthCodeAndState(
    authCode: $authCode
    state: $state
    userData: $userData
    role: $role
    flowType: $flowType
  ) {
    error {
      code
      accessToken
      __typename
    }
    user {
      id
      kaid
      __typename
    }
    isFirstLogin
    __typename
  }
}