mutation loginWithAppleAuthCodeAndState($authCode: String!, $state: String!, $userData: AppleUserData, $role: UserRole) {
  loginWithAppleAuthCodeAndState(
    authCode: $authCode
    state: $state
    userData: $userData
    role: $role
  ) {
    error {
      code
      accessToken
      __typename
    }
    user {
      id
      kaid
      __typename
    }
    isFirstLogin
    __typename
  }
}